# Copy to keystore.properties (git-ignored) after creating the upload key:
#   keytool -genkey -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep both the .jks and this file out of the repository and backed up somewhere
# safe: losing the upload key means asking Google to reset it.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
